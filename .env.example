# ─────────────────────────────────────────────────────────────────────────────
# Kromic Store — Frontend Environment Variables
#
# ── HOW TO USE ────────────────────────────────────────────────────────────────
# Local development : cp .env.example .env.local  (then edit)
# Vercel            : configure in Project Settings → Environment Variables
#                     set SEPARATE values per environment (Dev / Preview / Prod)
#
# ── SECURITY BOUNDARY ─────────────────────────────────────────────────────────
# NEXT_PUBLIC_* variables are inlined into the client JS bundle at build time.
# Everything else is server-only and NEVER reaches the browser.
#
# NEVER put the following in this file or in Vercel frontend env vars:
#   - Razorpay secret key
#   - Google OAuth client secret
#   - Cloudinary API secret
#   - Brevo / email provider API key
#   - JWT signing secret
#   - Database connection strings
#   - Any backend credential or token
#
# Those belong in the BACKEND deployment environment only.
# ─────────────────────────────────────────────────────────────────────────────

# ── Backend API ───────────────────────────────────────────────────────────────
# Base URL of the Kromic Commerce .NET API (no trailing slash).
# Configure separately per Vercel environment:
#   Development : http://localhost:5000
#   Preview     : https://api-staging.yourdomain.com
#   Production  : https://api.yourdomain.com
NEXT_PUBLIC_API_URL=http://localhost:5000

# ── Frontend URL ──────────────────────────────────────────────────────────────
# Canonical public URL of this Next.js application.
# Used for: OpenGraph metadataBase, canonical URLs.
#   Development : http://localhost:3000
#   Preview     : https://<vercel-preview-url>.vercel.app
#   Production  : https://yourdomain.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Environment label ─────────────────────────────────────────────────────────
# Used for conditional logging only.
# Allowed: development | staging | production
NEXT_PUBLIC_ENV=development

# ── Razorpay — DO NOT ADD A KEY HERE ─────────────────────────────────────────
# The Razorpay publishable Key ID is returned at runtime by the backend
# checkout response (CheckoutResponse.razorpayKeyId).
# It is loaded dynamically — no build-time frontend environment variable needed.
# This is intentional: each customer deployment has their own Razorpay account
# configured in the backend environment, not in the frontend.
#
# NEXT_PUBLIC_RAZORPAY_KEY_ID  ← DO NOT ADD THIS

# ── Analytics / Tracking ──────────────────────────────────────────────────────
# Tracking IDs are fetched at runtime from GET /api/v1/store/settings
# (PublicBusinessSettingsResponse.tracking.googleAnalyticsMeasurementId, .metaPixelId).
# You do NOT need to set them here.
# They are managed per-customer in the backend store settings.
#
# NEXT_PUBLIC_GA_MEASUREMENT_ID  ← loaded from store settings, not needed here
# NEXT_PUBLIC_META_PIXEL_ID      ← loaded from store settings, not needed here

# ── Theme switcher ────────────────────────────────────────────────────────────
# Set to true to show the floating theme switcher UI (bottom-right corner).
# Safe to enable on development and staging to preview alternate themes.
# Set to false or leave unset in production.
NEXT_PUBLIC_THEME_SWITCHER=false

# Fixed shopper-facing theme for this customer deployment. Server-only; choose
# one ID from src/theme/index.ts. Production customers receive exactly this theme.
SHOPEY_STORE_THEME=default
